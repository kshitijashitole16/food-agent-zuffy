{
  "name": "zuffy-food-agent-ui",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src vite.config.ts tsconfig.json package.json",
    "format:check": "prettier --check src vite.config.ts tsconfig.json package.json"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "sass": "1.105.1",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
